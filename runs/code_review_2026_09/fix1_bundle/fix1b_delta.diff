   313	def test_r10_total_covariance_matrix_matches_direct_conditioning(toy):
   314	    model, lik, x, y, x_test = toy
   315	    draws = [(0.7, 1.5, 0.05, 0.1), (3.0, 0.4, 0.2, 0.3), (1.2, 0.9, 0.1, 0.05)]
   316	    names = list(model.component_names)
   317	    res = decompose_model_hmc(model, lik, x, y, x_test, _samples(*zip(*draws)),
   318	                              kernel_builder=build_toy_kernels, n_posterior_samples=3,
   319	                              groups=[names], rng=np.random.default_rng(0))
   320	    direct = [_direct_draw(x, y, x_test, *d) for d in draws]
   321	    for name in names:
   322	        means = np.stack([d[0][name][0] for d in direct])
   323	        covs = np.stack([d[0][name][1] for d in direct])
   324	        expected = covs.mean(0) + np.cov(means, rowvar=False, bias=True)
   325	        assert np.allclose(res.components[name].cov, expected, atol=1e-10)
   326	        between = np.cov(means, rowvar=False, bias=True)
   327	        assert np.abs(between - np.diag(np.diag(between))).max() > 1e-6   # the fixture has off-diagonal between-draw terms
   328	    fm = np.stack([d[1][0] for d in direct])
   329	    fc = np.stack([d[1][1] for d in direct])
   330	    assert np.allclose(res.full.cov, fc.mean(0) + np.cov(fm, rowvar=False, bias=True), atol=1e-10)
   331	    assert np.allclose(res.group(names).cov, res.full.cov)
