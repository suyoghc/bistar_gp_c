   235	def test_r7_strict_evaluation_failure_inside_the_optimizer_raises():
   236	    ps = _space(_raises_in_band(0.0, 1e-6))          # fine at a=0, the 1e-8 finite-difference point raises
   237	    start = [{"a": 0.0, "sigma": 0.5}]
   238	    with pytest.raises(EvaluationFailure):
   239	        laplace_log_Z_Mx(ps, X_EVAL, GP, tau=1.0, starts=start)
   240	    with pytest.raises(EvaluationFailure):
   241	        is_log_Z_Mx(ps, X_EVAL, GP, [1.0], n_is=50, starts=start)
   242	    x_train = np.linspace(0.0, 1.0, 6)
   243	    with pytest.raises(EvaluationFailure):
   244	        laplace_log_evidence_ordinary(ps, x_train, 0.5 * x_train, mle_params={"a": 0.0, "sigma": 0.5})
   245	    assert issubclass(EvaluationFailure, RuntimeError)     # pass-1 callers catching RuntimeError still do
   246	    z = laplace_log_Z_Mx(ps, X_EVAL, GP, tau=1.0, starts=start, strict=False)
   247	    assert not z.converged                                 # non-strict: a flagged fallback, no raise
