   265	def test_r8_non_finite_hessian_stencil_is_flagged():
   266	    def predict(x, p):                      # finite at the optimum a=0.5 and at the 1e-8 gradient step,
   267	        a = p["a"]                          # NaN on the 1e-4 Hessian stencil
   268	        return (np.nan if 1e-6 < abs(a - 0.5) < 1e-3 else a) * x
