        "environment_note"
      ],
      "properties": {
        "worktree_git_reproducible": {"const": 156},
        "environment_interpreter_attested": {"const": 39812},
        "environment_note": {"type": "string", "minLength": 1}
      }
    },
    "provenance_classes": {
