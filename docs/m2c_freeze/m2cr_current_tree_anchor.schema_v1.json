    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l2_certification_commit", "d53_disposition", "holdout"],
      "properties": {
        "l2_certification_commit": {"const": "76f3c39631d8724c45db5f0e679608bffde39bbe"},
        "d53_disposition": {"type": "string", "minLength": 1},
        "holdout": {"type": "string", "minLength": 1}
      }
    }
  }
}
